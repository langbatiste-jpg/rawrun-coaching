{
  "functions": {
    "api/ai.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron-reminders",
      "schedule": "0 16 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|icons/|sw.js|manifest.webmanifest|favicon.svg).*)",
      "destination": "/index.html"
    }
  ]
}