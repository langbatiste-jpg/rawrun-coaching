# ── Navigateur (Vercel + fichier .env en local) ──
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ── Serveur uniquement (à mettre dans Vercel → Settings → Environment Variables) ──
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # Supabase → Project Settings → API → service_role (secret !)
COACH_EMAIL=ton@email.com               # reçoit les notifications
ANTHROPIC_API_KEY=sk-ant-...            # console.anthropic.com → API Keys
AI_MODEL=claude-sonnet-5-5              # optionnel
RESEND_API_KEY=re_...                   # NOUVELLE clé (l'ancienne est à révoquer)
RESEND_FROM=RAWRUN Coaching <onboarding@resend.dev>
STRAVA_CLIENT_ID=254589
STRAVA_CLIENT_SECRET=...                # NOUVEAU secret (l'ancien est à régénérer)
CRON_SECRET=une-longue-phrase-au-hasard # protège les rappels automatiques
